                </Ellipse.RenderTransform>
              </Ellipse>
              <Ellipse Width="122" Height="31" VerticalAlignment="Bottom" Margin="0,0,0,31" Fill="#355FE7F5" Stroke="#D9B8F8FF" StrokeThickness="1" />
              <Border Name="ProjectionScanLine" Width="238" Height="2" Background="#D982F0FF" VerticalAlignment="Bottom" Margin="0,0,0,35" Opacity="0.7" RenderTransformOrigin="0.5,0.5">
                <Border.RenderTransform>
                  <TranslateTransform x:Name="ProjectionScanTranslate" Y="0" />
                </Border.RenderTransform>
              </Border>
              <TextBlock Text="NANITE HOLOGRAPHIC LINK // 07" FontFamily="Consolas" FontSize="8" Foreground="#C682F0FF" HorizontalAlignment="Center" VerticalAlignment="Bottom" Margin="0,0,0,3" />
            </Grid>
            <Rectangle Name="HologramScanField" Width="430" Height="650" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="34,-42,0,0" IsHitTestVisible="False" Opacity="0.22">
              <Rectangle.Fill>
                <DrawingBrush TileMode="Tile" Viewport="0,0,8,11" ViewportUnits="Absolute">
                  <DrawingBrush.Drawing>
                    <GeometryDrawing Brush="#427CEAF7">
                      <GeometryDrawing.Geometry><RectangleGeometry Rect="0,0,8,1" /></GeometryDrawing.Geometry>
                    </GeometryDrawing>
                  </DrawingBrush.Drawing>
                </DrawingBrush>
              </Rectangle.Fill>
            </Rectangle>
            <Image Name="CharacterGhostImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Opacity="0" IsHitTestVisible="False" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
              <Image.RenderTransform>
                <TransformGroup>
                  <ScaleTransform ScaleX="1.002" ScaleY="1" />
                  <TranslateTransform x:Name="CharacterGhostTranslate" X="28" Y="-72" />
                </TransformGroup>
              </Image.RenderTransform>
            </Image>
            <Image Name="CharacterImage" Stretch="Uniform" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="0,0,0,0" RenderOptions.BitmapScalingMode="HighQuality" RenderTransformOrigin="0.5,0.5">
              <UIElement.RenderTransform>
                <TransformGroup>
                  <ScaleTransform x:Name="CharacterScale" ScaleX="1" ScaleY="1" />
                  <ScaleTransform x:Name="CharacterBreathScale" ScaleX="1" ScaleY="1" />
                  <ScaleTransform x:Name="CharacterBlinkScale" ScaleX="1" ScaleY="1" />
                  <RotateTransform x:Name="CharacterRotate" Angle="0" />
                  <TranslateTransform x:Name="CharacterTranslate" X="20" Y="-70" />
                  <TranslateTransform x:Name="CharacterGlitchTranslate" X="0" Y="0" />
                </TransformGroup>
              </UIElement.RenderTransform>
            </Image>
            <Canvas Name="SignalNoiseLayer" IsHitTestVisible="False" ClipToBounds="True" Opacity="0.18" />
            <Border Name="GlitchBandUpper" Width="420" Height="5" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="35,-230,0,0" Background="#A662E8F7" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><TranslateTransform x:Name="GlitchBandUpperTranslate" /></Border.RenderTransform>
            </Border>
            <Border Name="GlitchBandLower" Width="350" Height="3" HorizontalAlignment="Center" VerticalAlignment="Center" Margin="15,245,0,0" Background="#8FF0C887" Opacity="0" IsHitTestVisible="False" RenderTransformOrigin="0.5,0.5">
              <Border.RenderTransform><TranslateTransform x:Name="GlitchBandLowerTranslate" /></Border.RenderTransform>
            </Border>
          </Grid>
        </Grid>
        <Grid Column="2">
          <Grid.RowDefinitions>
            <RowDefinition Height="88" />
            <RowDefinition Height="50" />
            <RowDefinition Height="*" />
            <RowDefinition Height="64" />
          </Grid.RowDefinitions>
          <Border Grid.Row="0" Background="#F0111922" BorderBrush="#688796A2" BorderThickness="1" CornerRadius="4" Padding="18,13" Effect="{StaticResource PanelShadow}">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="ACTIVE DIRECTORY" FontFamily="Consolas" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" />
                <TextBlock Name="ActiveFolderText" Text="待整理信号" FontSize="20" FontWeight="Bold" Margin="0,4,0,0" />
                <TextBlock Name="ActivePathText" Text="未绑定路径" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
              </StackPanel>
              <Border Grid.Column="1" Background="#17252F38" BorderBrush="#52687580" BorderThickness="1" CornerRadius="3" Padding="10,6" VerticalAlignment="Center">
                <StackPanel>
                  <TextBlock Text="STATE" FontFamily="Consolas" FontSize="7" Foreground="{StaticResource Faint}" HorizontalAlignment="Center" />
                  <TextBlock Name="ActiveStateText" Text="IDLE" FontFamily="Consolas" FontSize="16" Foreground="{StaticResource Gold}" HorizontalAlignment="Center" />
                </StackPanel>
              </Border>
            </Grid>
          </Border>
          <Grid Row="1" Margin="0,8,0,7">
            <Grid.ColumnDefinitions>
              <ColumnDefinition Width="*" />
              <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <Border Background="#D70B1118" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="3" Padding="10,0">
              <Grid>
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="Auto" />
                  <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="⌕" FontSize="18" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" Margin="0,-3,8,0" />
              <TextBox Name="SearchBox" Grid.Column="1" Background="#00FFFFFF" BorderThickness="0" Foreground="#FFFFFFFF" CaretBrush="{StaticResource Cyan}" FontSize="12" FontWeight="SemiBold" VerticalContentAlignment="Center" Language="zh-CN" InputMethod.IsInputMethodEnabled="True" InputMethod.PreferredImeState="On" GotKeyboardFocus="TextInput_GotKeyboardFocus" LostKeyboardFocus="TextInput_LostKeyboardFocus" TextChanged="SearchBox_TextChanged" />
              </Grid>
            </Border>
            <StackPanel Grid.Column="1" Orientation="Horizontal">
              <Button Style="{StaticResource TerminalButton}" Content="中 INPUT" Margin="7,0,0,0" Click="SearchImeButton_Click" />
              <Button Style="{StaticResource TerminalButton}" Content="↑ UP" Margin="7,0,0,0" Click="NavigateUpButton_Click" />
              <Button Style="{StaticResource TerminalButton}" Content="↻ SCAN" Margin="7,0,0,0" Click="RefreshButton_Click" />
            </StackPanel>
          </Grid>
          <Border Grid.Row="2" Background="#E9090D13" BorderBrush="#52616E78" BorderThickness="1" CornerRadius="3" ClipToBounds="True" Effect="{StaticResource PanelShadow}">
            <Grid>
              <Grid.RowDefinitions>
                <RowDefinition Height="38" />
                <RowDefinition Height="*" />
              </Grid.RowDefinitions>
              <Grid Background="#B719222B" Margin="1">
                <Grid.ColumnDefinitions>
                  <ColumnDefinition Width="54" />
                  <ColumnDefinition Width="*" />
                  <ColumnDefinition Width="110" />
                </Grid.ColumnDefinitions>
                <TextBlock Text="TYPE" FontFamily="Consolas" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                <TextBlock Grid.Column="1" Text="终端条目" FontSize="10" FontWeight="SemiBold" Foreground="{StaticResource Silver}" VerticalAlignment="Center" />
                <TextBlock Grid.Column="2" Text="更新时间" FontSize="9" FontWeight="SemiBold" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
              </Grid>
              <ListBox Name="FileList" Grid.Row="1" Background="#00FFFFFF" BorderThickness="0" SelectionMode="Single" ScrollViewer.HorizontalScrollBarVisibility="Disabled" MouseDoubleClick="FileList_MouseDoubleClick">
                <ItemsControl.ItemContainerStyle>
                  <Style TargetType="{x:Type ListBoxItem}">
                    <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                    <Setter Property="Padding" Value="0" />
                    <Setter Property="Background" Value="#00FFFFFF" />
                    <Setter Property="BorderThickness" Value="0,0,0,1" />
                    <Setter Property="BorderBrush" Value="#20374650" />
                    <Setter Property="FocusVisualStyle" Value="{x:Null}" />
                    <Style.Triggers>
                      <Trigger Property="UIElement.IsMouseOver" Value="True">
                        <Setter Property="Background" Value="#3C1C2D38" />
                      </Trigger>
                      <Trigger Property="IsSelected" Value="True">
                        <Setter Property="Background" Value="#C32A4653" />
                        <Setter Property="BorderBrush" Value="#8AD9F4FC" />
                        <Setter Property="Foreground" Value="#FFFFFFFF" />
                      </Trigger>
                    </Style.Triggers>
                  </Style>
                </ItemsControl.ItemContainerStyle>
                <ItemsControl.ItemTemplate>
                  <DataTemplate>
                    <Grid MinHeight="52">
                      <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="54" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="110" />
                      </Grid.ColumnDefinitions>
                      <Border Width="34" Height="27" BorderBrush="#6C9BAAB4" BorderThickness="1" CornerRadius="2" HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock FontFamily="Consolas" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center" VerticalAlignment="Center" Text="{Binding Badge}" />
                      </Border>
                      <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="0,0,8,0">
                        <TextBlock FontSize="12" FontWeight="SemiBold" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis" Text="{Binding Name}" ToolTip="{Binding FullPath}" />
                        <TextBlock FontSize="8.5" Foreground="{StaticResource Muted}" Margin="0,3,0,0" Text="{Binding TypeLabel}" />
                      </StackPanel>
                      <TextBlock Grid.Column="2" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center" Text="{Binding ModifiedLabel}" />
                    </Grid>
                  </DataTemplate>
                </ItemsControl.ItemTemplate>
              </ListBox>
              <StackPanel Name="EmptyState" Grid.Row="1" VerticalAlignment="Center" HorizontalAlignment="Center">
                <TextBlock Text="NO SIGNAL" FontFamily="Consolas" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource Cyan}" HorizontalAlignment="Center" />
                <TextBlock Text="当前目录没有可显示的条目" FontSize="11" Foreground="{StaticResource Muted}" Margin="0,8,0,0" HorizontalAlignment="Center" />
              </StackPanel>
            </Grid>
          </Border>
          <Border Grid.Row="3" Background="#BD0D141B" BorderBrush="{StaticResource LineSoft}" BorderThickness="1" CornerRadius="3" Margin="0,8,0,0" Padding="12,8">
            <Grid>
              <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
              </Grid.ColumnDefinitions>
              <StackPanel>
                <TextBlock Text="RECLAMATION VAULT" FontFamily="Consolas" FontSize="8" FontWeight="SemiBold" Foreground="{StaticResource Gold}" />
                <TextBlock Name="RecycleText" Text="回收站状态读取中" FontSize="10" Foreground="{StaticResource Silver}" Margin="0,3,0,0" />
              </StackPanel>
              <Button Grid.Column="1" Style="{StaticResource TerminalButton}" Content="OPEN  ↗" Padding="10,5" Click="RecycleButton_Click" />
            </Grid>
          </Border>
        </Grid>
      </Grid>
      <Border Grid.Row="2" Margin="18,4,18,5" Background="#F20A1017" BorderBrush="#667C929E" BorderThickness="1" CornerRadius="4" Effect="{StaticResource PanelShadow}">
        <Grid>
          <Grid.RowDefinitions><RowDefinition Height="76" /><RowDefinition Height="*" /></Grid.RowDefinitions>
          <Grid Grid.Row="0" Margin="14,7,14,2">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230" />
            <ColumnDefinition Width="148" />
            <ColumnDefinition Width="245" />
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="104" />
            <ColumnDefinition Width="116" />
            <ColumnDefinition Width="164" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel VerticalAlignment="Center">
            <StackPanel Orientation="Horizontal">
              <TextBlock Text="♪" FontSize="20" Foreground="{StaticResource Cyan}" Margin="0,-2,8,0" />
              <TextBlock Text="QQ MUSIC UPLINK" FontFamily="Consolas" FontSize="10" FontWeight="Bold" Foreground="{StaticResource Cyan}" VerticalAlignment="Center" />
            </StackPanel>
            <TextBlock Name="MusicConnectionText" Text="正在连接系统媒体会话" FontSize="10" Foreground="{StaticResource Muted}" Margin="28,2,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
            <Button Style="{StaticResource TerminalButton}" Content="◀◀" Width="40" Height="36" Padding="4" Click="MusicPreviousButton_Click" ToolTip="上一首" />
            <Button Name="MusicPlayPauseButton" Style="{StaticResource TerminalButton}" Content="▶" Width="46" Height="40" Padding="4" Margin="5,0" Click="MusicPlayPauseButton_Click" ToolTip="播放 / 暂停" />
            <Button Style="{StaticResource TerminalButton}" Content="▶▶" Width="40" Height="36" Padding="4" Click="MusicNextButton_Click" ToolTip="下一首" />
          </StackPanel>
          <StackPanel Grid.Column="2" VerticalAlignment="Center" Margin="10,0,14,0">
            <TextBlock Name="MusicTitleText" Text="等待 QQ 音乐信号" FontSize="14" FontWeight="Bold" Foreground="#FFFFFFFF" TextTrimming="CharacterEllipsis" />
            <TextBlock Name="MusicArtistText" Text="开机续播 · 上次播放队列" FontSize="10" Foreground="{StaticResource Muted}" Margin="0,4,0,0" TextTrimming="CharacterEllipsis" />
          </StackPanel>
          <Slider Name="MusicProgressSlider" Grid.Column="3" Minimum="0" Maximum="100" Value="0" Height="28" VerticalAlignment="Center" Margin="4,0,12,0" Foreground="{StaticResource Cyan}" ValueChanged="MusicProgressSlider_ValueChanged" PreviewMouseLeftButtonDown="MusicProgressSlider_PreviewMouseLeftButtonDown" PreviewMouseLeftButtonUp="MusicProgressSlider_PreviewMouseLeftButtonUp" />
          <TextBlock Name="MusicTimeText" Grid.Column="4" Text="00:00 / 00:00" FontFamily="Consolas" FontSize="10" Foreground="#FFFFFFFF" HorizontalAlignment="Center" VerticalAlignment="Center" />
          <Button Name="MusicModeButton" Grid.Column="5" Style="{StaticResource TerminalButton}" Content="顺序播放" Margin="7,0" Padding="10,7" Click="MusicModeButton_Click" ToolTip="切换播放模式" />
          <Grid Grid.Column="6" Margin="5,0,12,0" VerticalAlignment="Center">
            <Grid.ColumnDefinitions><ColumnDefinition Width="34" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
            <TextBlock Text="VOL" FontFamily="Consolas" FontSize="9" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
            <Slider Name="MusicVolumeSlider" Grid.Column="1" Minimum="0" Maximum="100" Value="62" Height="28" VerticalAlignment="Center" Foreground="{StaticResource Cyan}" ValueChanged="MusicVolumeSlider_ValueChanged" />
          </Grid>
          <StackPanel Grid.Column="7" Orientation="Horizontal" VerticalAlignment="Center">
            <Button Style="{StaticResource TerminalButton}" Content="绑定专辑 / 歌单" Padding="11,7" Click="BindMusicPlaylistButton_Click" ToolTip="保存开机自动播放的 QQ 音乐专辑或歌单分享链接" />
            <Button Style="{StaticResource TerminalButton}" Content="打开 QQ 音乐 ↗" Margin="7,0,0,0" Padding="11,7" Click="OpenQQMusicButton_Click" />
          </StackPanel>
          </Grid>
          <Border Grid.Row="1" Margin="14,0,14,7" Background="#9A081118" BorderBrush="#3552636D" BorderThickness="1" CornerRadius="2" ClipToBounds="True">
            <Grid>
              <UniformGrid Name="AudioVisualizerBars" Rows="1" Margin="8,3,8,2" IsHitTestVisible="False" />
              <TextBlock Text="LIVE AUDIO SPECTRUM  //  WINDOWS OUTPUT PEAK" FontFamily="Consolas" FontSize="7" Foreground="#8797B9C5" HorizontalAlignment="Right" VerticalAlignment="Top" Margin="0,2,8,0" IsHitTestVisible="False" />
            </Grid>
          </Border>
        </Grid>
      </Border>
      <Border Grid.Row="3" Background="#FF05070A" BorderBrush="#26374049" BorderThickness="0,1,0,0">
        <Grid Margin="22,0">
          <Grid.ColumnDefinitions>
            <ColumnDefinition Width="*" />
            <ColumnDefinition Width="Auto" />
          </Grid.ColumnDefinitions>
          <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
            <Ellipse Width="5" Height="5" Fill="{StaticResource Good}" Margin="0,0,7,0" />
            <TextBlock Name="FooterStatusText" Text="LOG // TERMINAL READY" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource Muted}" />
          </StackPanel>
          <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
            <TextBlock Name="NetworkText" Text="NETWORK // LOCAL" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource Muted}" Margin="0,0,25,0" />
            <TextBlock Name="BatteryText" Text="POWER // --" FontFamily="Consolas" FontSize="8" Foreground="{StaticResource Muted}" />
          </StackPanel>
        </Grid>
      </Border>
    </Grid>
  </Grid>
</Window>
